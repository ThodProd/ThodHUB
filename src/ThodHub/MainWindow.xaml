<Window x:Class="ThodHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="ThodHUB" Width="1240" Height="820" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F7F8FA">
  <Grid><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#F7F8FA" />
    <StackPanel x:Name="StartupHelp" Visibility="Collapsed" MaxWidth="560" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="Не удалось запустить интерфейс" FontSize="25" FontWeight="SemiBold" Foreground="#24262B"/>
      <TextBlock Text="Для ThodHUB нужен Microsoft Edge WebView2 Runtime. Если компонент отсутствует, скачайте Evergreen Runtime с сайта Microsoft, установите его и откройте хаб снова." TextWrapping="Wrap" FontSize="14" Foreground="#767B85" Margin="0,16,0,20"/>
      <Button Content="Открыть сайт Microsoft" HorizontalAlignment="Left" Padding="16,10" Click="WebViewDownload_Click"/>
      <Expander Header="Подробности ошибки" Margin="0,20,0,0"><TextBox x:Name="StartupError" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Padding="10"/></Expander>
    </StackPanel>
  </Grid>
</Window>
